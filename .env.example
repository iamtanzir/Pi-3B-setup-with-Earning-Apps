# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored — never commit real credentials.

# Pi-hole admin password (used at http://<pi-ip>/admin)
PIHOLE_PASSWORD=change-me-strong-password

# Honeygain account credentials
HONEYGAIN_EMAIL=you@example.com
HONEYGAIN_PASS=your-honeygain-password

# Unique device name for this Pi (must be unique across YOUR Honeygain account,
# e.g. pi3b-bedroom, pi3b-livingroom). Do NOT reuse the same name on two devices.
DEVICE_NAME=pi3b-server

# Timezone used inside the containers
TZ=Asia/Dhaka
